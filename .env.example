# Copy to .env.local for local overrides. Never commit real values.

# Hosted database (required on Vercel). Leave unset locally to use data/farm.db.
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# Required in production: typed once on /setup to create the first admin account.
SETUP_CODE=
